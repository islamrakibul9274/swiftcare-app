# Use a separate development database. Never seed production.
MONGODB_URI=mongodb://127.0.0.1:27017/swiftcare_dev?replicaSet=rs0
# Generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional email delivery; Admin can share invitations/reset links manually.
RESEND_API_KEY=
MAIL_FROM=
# Only the isolated demo launcher sets this automatically.
SWIFTCARE_DEMO=false
# Only for the explicit one-time bootstrap CLI; never expose as NEXT_PUBLIC_.
BOOTSTRAP_PASSWORD=

# Optional daily credential reminder cron. Generate a random 32+ character secret.
CRON_SECRET=
